
# Wikimedia User-Agent policy: client/version (contact URL; contact e-mail)
USER_AGENT="BearApp/0.1 (https://github.com/timmy-2003/WebEngineering_Exercises_Nicholson; timothy.nicholson@stud.hcw.ac.at)"

WIKIPEDIA_BASE_URL=https://en.wikipedia.org
UPSTREAM_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:4173
ENABLE_DEBUG_ROUTES=false

# Request logs: pretty (readable, default) or json (one JSON object per line)
LOG_FORMAT=pretty

# PostgreSQL: compose service "db"; port 5432 is published for npm run dev and psql.
POSTGRES_USER=bears
POSTGRES_PASSWORD=bears
POSTGRES_DB=bears
DATABASE_URL=postgres://bears:bears@localhost:5432/bears
