{
  "name": "webengineering_exercises_nicholson",
  "version": "1.0.0",
  "description": "Wildlife website coding playground for the Web Engineering course.",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "preview": "ng serve --configuration production",
    "typecheck": "ngc -p tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "author": "Timothy Nicholson",
  "license": "ISC",
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.html": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  }
}
