{
  "name": "webengineering_exercises_nicholson",
  "version": "1.0.0",
  "private": true,
  "description": "Wildlife website coding playground for the Web Engineering course.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ui": "npm run test:ui -w apps/api",
    "db:generate": "npm run db:generate -w apps/api --",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "prepare": "husky"
  },
  "author": "Timothy Nicholson",
  "license": "ISC",
  "lint-staged": {
    "apps/*/src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/api/test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/src/**/*.html": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "angular-eslint": "^22.6.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
